# Supabase (PostgreSQL only — server-side reads; do not commit real values)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Path to bank transaction workbook (default: ./Transaction.xlsx at repo root)
# TRANSACTION_XLSX_PATH=/absolute/path/to/Transaction.xlsx

# Path to TNG raw statement text dump (default: ./data.txt at repo root)
# Example on owner Mac (coinflow export):
# TNG_DATA_PATH=/Users/chin/Documents/GitHub/coinflow/public/data.txt
# TNG_DATA_PATH=./data.txt

# Optional: show wallet balance-check warnings on /wallets/tng (reconcile logic on hold — default off)
# TNG_RECONCILE_ENABLED=true